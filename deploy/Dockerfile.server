# Build the Go server from source (Server)
FROM golang:1.22-bookworm AS build

WORKDIR /src

# Copy and download deps first for better layer caching
COPY Server/go.mod Server/go.sum ./Server/
WORKDIR /src/Server
RUN go mod download

# Copy the rest of the source
COPY Server ./

# Build for the native target architecture of the Docker host.
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/aztectrials-server .

# Minimal runtime image
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app
COPY --from=build /out/aztectrials-server /app/server

# Optional GeoIP DB (MaxMind mmdb). If the file is missing, build will fail.
COPY Server/Maxmind/GeoLite2-City.mmdb /app/GeoLite2-City.mmdb

EXPOSE 8080

ENTRYPOINT ["/app/server"]
