# AztecTrials runtime configuration.
# The server still consumes BUGGYPYRAMID_* variable names internally because this
# project was duplicated from the original leaderboard server. Keep these names.

BUGGYPYRAMID_ADMIN_KEY=change_me

# Postgres database used only by the AztecTrials stack.
# This DB is not exposed publicly; only the AztecTrials containers can reach it.
BUGGYPYRAMID_DB_NAME=aztectrials
BUGGYPYRAMID_DB_USER=aztectrials
BUGGYPYRAMID_DB_PASSWORD=change_me

# Public hostname routed by the existing edge nginx container.
BUGGYPYRAMID_PUBLIC_HOST=aztec.blobfishman.xyz

# Private Admin Web App host binding. Do not use 0.0.0.0 or the public VPS IP.
BUGGYPYRAMID_ADMIN_BIND_IP=192.168.178.27
BUGGYPYRAMID_ADMIN_PORT=8082

# Email used for LetsEncrypt registration/expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# Compose project name for the independent stack.
COMPOSE_PROJECT_NAME=aztectrials
